# When using published port 55432: DATABASE_URL=postgresql+psycopg2://as:as_dev@localhost:55432/as_app
DATABASE_URL=postgresql+psycopg2://as:as_dev@localhost:55432/as_app
AUTH_SECRET=change-me-phase1-dev-secret-min-32-chars!!
AUTH_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_SECURE=false
DEFAULT_VENDOR_ID=1
STORAGE_ROOT=./storage
ENVIRONMENT=development
DEBUG=true
