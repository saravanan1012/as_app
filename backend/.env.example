# When using published port 55432: DATABASE_URL=postgresql+psycopg2://as:as_dev@localhost:55432/as_app
DATABASE_URL=postgresql+psycopg2://as:as_dev@localhost:55432/as_app
AUTH_SECRET=change-me-phase1-dev-secret-min-32-chars!!
AUTH_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_SECURE=false
DEFAULT_VENDOR_ID=1
STORAGE_ROOT=./storage
ENVIRONMENT=development
DEBUG=true

# SMTP (optional locally)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
ORDER_NOTIFY_TO=
