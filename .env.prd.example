# Production secrets — copy to `.env.prd` on the VPS (never commit).
# Domain example matches legacy AS Organic; change if DNS differs.

POSTGRES_USER=as
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=as_app

DATABASE_URL=postgresql+psycopg2://as:change-me-strong-db-password@db:5432/as_app

AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars
AUTH_URL=https://as.hindupanjang.com
CORS_ORIGINS=https://as.hindupanjang.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
DEFAULT_VENDOR_ID=1

# After first boot + ETL, set SKIP_SEED=1 so entrypoint only migrates.
SKIP_SEED=0

RAZORPAY_MOCK=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

NUXT_PUBLIC_VENDOR_SLUG=as-demo
NUXT_PUBLIC_APP_URL=https://as.hindupanjang.com

# Deploy script health (host publishes web on :3001)
# AS_UPSTREAM_URL=http://94.249.213.162:3001
