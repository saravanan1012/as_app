# Local / docker-compose defaults (never use these secrets in production)
# Copy to `.env` and fill values. docker compose reads host env / `.env` for Razorpay.

POSTGRES_USER=as
POSTGRES_PASSWORD=as_dev
POSTGRES_DB=as_app
DATABASE_URL=postgresql+psycopg2://as:as_dev@db:5432/as_app

# Min 32 chars. Rotate for every environment.
AUTH_SECRET=change-me-phase1-dev-secret-min-32-chars!!
AUTH_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DEFAULT_VENDOR_ID=1

# Skip demo seed after production ETL (entrypoint)
SKIP_SEED=0

# Razorpay — Dashboard → API Keys → Test mode (`rzp_test_*`).
# Set MOCK=false and real test key id/secret, then restart API so Checkout.js opens.
# Leave MOCK=true (or empty keys) for local/CI mock verify without Checkout.js.
RAZORPAY_MOCK=false
RAZORPAY_KEY_ID=rzp_test_ReplaceWithYourTestKeyId
RAZORPAY_KEY_SECRET=ReplaceWithYourTestKeySecret

# Frontend (Nuxt)
NUXT_PUBLIC_VENDOR_SLUG=as-demo
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_API_PROXY=http://localhost:8000
